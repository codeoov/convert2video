<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Legacy compatibility: API 26-28 devices require WRITE_EXTERNAL_STORAGE to write to
         external storage. Kept for devices running Android 9 or below; no-op on API 29+. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Audio read: API 33+ uses READ_MEDIA_AUDIO; API 29-32 needs no extra permission for
         MediaStore reads; API 26-28 uses READ_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- RecordingService microphone FGS requires granted RECORD_AUDIO and a visible Activity
         or an applicable user-eligible start exemption; an exact alarm alone is insufficient. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Bluetooth mic routing (install-time; no runtime dialog). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- SCHEDULE_EXACT_ALARM is user-granted special access for exact scheduling of scheduled
         recording and Quick Timer; the Options banner opens the system permission settings. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- D-6: re-register enabled schedule START alarms after reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Background conversion (SON-7): runs as a WorkManager foreground service with an ongoing
         progress notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <!-- YouTube upload: Google authorization + Data API v3 calls over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".Convert2videoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Convert2video">

        <!-- WorkManager merges these types to match ForegroundInfo: conversion uses dataSync on
             API 29-33 and mediaProcessing on API 34+; uploads use dataSync on API 29+.
             mediaProcessing is supported on earlier platform versions too, but its
             Service.onTimeout(int, int) callback is unavailable before API 35; stop promptly
             on completion, cancellation, or failure rather than waiting for that callback. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaProcessing|dataSync"
            tools:node="merge" />

        <!-- Pre-API 33: AppCompat auto-persists per-app locales (API 33+ uses LocaleManager). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Phase 1 recording: microphone FGS (capture) + dataSync FGS (Keep IO). -->
        <service
            android:name=".record.RecordingService"
            android:foregroundServiceType="microphone|dataSync"
            android:exported="false" />

        <service
            android:name=".desktopsync.PairingServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Quick Settings tile: one-tap start/stop without opening the app. -->
        <service
            android:name=".record.RecordingTileService"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:label="@string/recording_notification_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Sprint 6: 1×1 Glance QuickRecord home-screen widget. -->
        <receiver
            android:name=".record.QuickRecordWidgetReceiver"
            android:exported="false"
            android:label="@string/quick_record_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_record_widget_info" />
        </receiver>

        <!-- D-5: 예약 녹음 AlarmManager 타깃 (explicit PendingIntent only; exported=false). -->
        <receiver
            android:name=".record.ScheduledRecordingReceiver"
            android:exported="false" />

        <!-- D-6: 부팅 후 enabled 스케줄 START 알람 재등록 (mid-window start 금지). -->
        <receiver
            android:name=".record.BootRecordingScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Convert2video">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- FileProvider: shares app-private external files (Movies/C2V) with video players
             and upload workers. Authority must match C2vOutputNames.FILE_PROVIDER_AUTHORITY. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
