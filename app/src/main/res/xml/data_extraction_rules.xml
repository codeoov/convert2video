<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/pairing_token.preferences_pb" />
        <exclude domain="file" path="datastore/entitlement.preferences_pb" />
        <exclude domain="sharedpref" path="crash_reporter.xml" />
        <exclude domain="sharedpref" path="youtube_auth.xml" />
        <exclude domain="sharedpref" path="drive_auth.xml" />
        <exclude domain="sharedpref" path="install_id.xml" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/pairing_token.preferences_pb" />
        <exclude domain="file" path="datastore/entitlement.preferences_pb" />
        <exclude domain="sharedpref" path="crash_reporter.xml" />
        <exclude domain="sharedpref" path="youtube_auth.xml" />
        <exclude domain="sharedpref" path="drive_auth.xml" />
        <exclude domain="sharedpref" path="install_id.xml" />
    </device-transfer>
</data-extraction-rules>
