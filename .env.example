DB_HOST=localhost
DB_NAME=recorderdb
DB_USER=recorderadmin
DB_PASS=

# Absolute path to the Google service account JSON (do not commit the file itself)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json
# Android app package name as registered in Google Play Console
ANDROID_PACKAGE_NAME=com.convert2video
# Google Play in-app product ID for the pro entitlement
PLAY_PRODUCT_ID=pro_lifetime_unlock
# Huawei AppGallery in-app product ID for the pro entitlement
HUAWEI_PRODUCT_ID=pro_lifetime_unlock
# Huawei AppGallery Connect API client credentials (deployment secret)
HUAWEI_APP_ID=
HUAWEI_APP_SECRET=
# HTTPS-only Huawei OAuth and order-verification endpoints
HUAWEI_OAUTH_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HUAWEI_ORDER_VERIFY_URL=https://orders-dre.iap.cloud.huawei.eu/applications/purchases/tokens/verify
# Absolute path to the RSA private key PEM for signing entitlement JWTs (do not commit)
ENTITLEMENT_JWT_PRIVATE_KEY_PATH=/path/to/entitlement-private.pem
# Service account email used by Google Pub/Sub push subscription for RTDN webhooks
PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
# Exact HTTPS audience configured on the Pub/Sub push subscription
PUBSUB_PUSH_AUDIENCE=https://api.example.com/webhooks/rtdn
