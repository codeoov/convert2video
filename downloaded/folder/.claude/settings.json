{
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Remove-Item)",
      "PowerShell(rm *)",
      "PowerShell(del *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.cursor/hooks/harness-inject-rules.ps1\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-stop-checks.ps1\"",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-stop-compile.ps1\"",
            "timeout": 900
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/check-lazy-in-scroll.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-report.ps1\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
